format = 1

[sim]
name = "mag-tov"
summary = "A magnetized TOV neutron star with CottonmouthBSSNOK4m and AsterX GRMHD on CarpetX (6 AMR levels)"
description = """
A stable, magnetized Tolman-Oppenheimer-Volkoff neutron star in equilibrium, evolved with
CottonmouthBSSNOK4m (BSSN-OK, 4th order, matter terms enabled) coupled to the AsterX GRMHD solver on
the CarpetX AMR driver, from Cottonmouth's examples/mag_TOV.par (adapted from AsterX's
test/magTOV_Z4c_AMR.par).

An ideal-gas/polytrope EOS (Gamma = 2, K = 100) with central density 1.28e-3 (M = 1.4, M_b = 1.506),
an internal dipole field (A_b = 100, pressure cutoff 4% of the maximum), HLLE fluxes with PPM
reconstruction, Noble con2prim with Palenzuela as fallback. Domain [-512, +512]^3 with a 128^3 base
grid and 6 static BoxInBox levels, RK4 with CFL factor 0.25, to t = 1600 M, checkpointing (openPMD)
every 12 hours of wall time."""
# The license of the Cottonmouth repo (LICENSE), whose examples/ this parfile comes from.
license = "AGPL-3.0-or-later"
contact = "https://github.com/EinsteinToolkit/tickets/issues"
root = "Cactus"

