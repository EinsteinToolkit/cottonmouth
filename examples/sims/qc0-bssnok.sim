format = 1

[sim]
name = "qc0-bssnok"
summary = "QC-0 binary black hole merger with CottonmouthBSSNOK4m on CarpetX (BSSN-OK, 4th order, 7 AMR levels)"
description = """
An equal-mass, quasi-circular binary black hole inspiral through merger (QC-0), evolved with
CottonmouthBSSNOK4m: the BSSN-OK formulation with 4th-order stencils and matter terms enabled, on
the CarpetX AMR driver, from Cottonmouth's examples/qc0-bssnok.par.

TwoPunctures initial data (m = 0.453 each), RK4 with CFL factor 0.45, domain [-190, +190]^3 with a
256^3 base grid and 7 BoxInBox levels regridded every 16 iterations, DDF prolongation of order 5.
Psi4 is extracted with CanudaX_NPScalars and Multipole at 8 radii; AHFinderDirect tracks 3 horizons
and PunctureTracker the punctures. It runs to t = 300 M, checkpointing (openPMD) every 6 hours of
wall time."""
# The license of the Cottonmouth repo (LICENSE), whose examples/ this parfile comes from.
license = "AGPL-3.0-or-later"
contact = "https://github.com/EinsteinToolkit/tickets/issues"
root = "Cactus"

